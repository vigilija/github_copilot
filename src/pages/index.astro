---
const title = 'GitHub Contribution Battle Arena';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Compare GitHub contribution activity in a friendly head-to-head battle." />
		<title>{title} | Mona Mayhem</title>
	</head>
	<body>
		<main class="arena">
			<header class="intro">
				<p class="eyebrow">Mona Mayhem presents</p>
				<h1>{title}</h1>
				<p>Two developers enter. Compare a year of GitHub contributions.</p>
			</header>

			<form id="battle-form" novalidate>
				<div class="players">
					<div class="field">
						<label for="player-one">Player 1</label>
						<div class="username-input">
							<span aria-hidden="true">@</span>
							<input
								id="player-one"
								name="playerOne"
								type="text"
								autocomplete="username"
								placeholder="octocat"
								maxlength="39"
								aria-describedby="battle-status"
								required
							/>
						</div>
					</div>

					<span class="versus" aria-hidden="true">VS</span>

					<div class="field">
						<label for="player-two">Player 2</label>
						<div class="username-input">
							<span aria-hidden="true">@</span>
							<input
								id="player-two"
								name="playerTwo"
								type="text"
								autocomplete="off"
								placeholder="torvalds"
								maxlength="39"
								aria-describedby="battle-status"
								required
							/>
						</div>
					</div>
				</div>

				<button id="battle-button" type="submit">Start battle</button>
				<p id="battle-status" class="status" role="status" aria-live="polite"></p>
			</form>

			<section id="results" class="results" aria-label="Battle results" hidden></section>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
		background: #111827;
		color: #f9fafb;
		font-family: system-ui, sans-serif;
	}

	.arena {
		width: min(100% - 2rem, 960px);
		margin: 0 auto;
		padding: 4rem 0;
	}

	.intro {
		margin-bottom: 2.5rem;
		text-align: center;
	}

	.eyebrow {
		color: #a78bfa;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.5rem 0;
		font-size: clamp(2rem, 6vw, 3.5rem);
		line-height: 1.1;
	}

	.intro > p:last-child {
		color: #cbd5e1;
	}

	form {
		padding: 1.5rem;
		border: 1px solid #374151;
		border-radius: 1rem;
		background: #1f2937;
	}

	.players {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: end;
		gap: 1.25rem;
	}

	.field label {
		display: block;
		margin-bottom: 0.5rem;
		font-weight: 700;
	}

	.username-input {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0 0.75rem;
		border: 1px solid #64748b;
		border-radius: 0.5rem;
		background: #111827;
		color: #a78bfa;
	}

	input {
		width: 100%;
		min-width: 0;
		padding: 0.75rem 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: #f9fafb;
		font: inherit;
	}

	.username-input:focus-within {
		outline: 2px solid #a78bfa;
		outline-offset: 2px;
	}

	input::placeholder {
		color: #94a3b8;
	}

	.versus {
		padding-bottom: 0.7rem;
		color: #fbbf24;
		font-weight: 900;
	}

	button {
		display: block;
		min-width: 12rem;
		margin: 1.5rem auto 0;
		padding: 0.85rem 1.25rem;
		border: 0;
		border-radius: 0.5rem;
		background: #7c3aed;
		color: white;
		font: inherit;
		font-weight: 800;
		cursor: pointer;
	}

	button:hover:not(:disabled) {
		background: #6d28d9;
	}

	button:focus-visible {
		outline: 3px solid #c4b5fd;
		outline-offset: 3px;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.7;
	}

	.status {
		min-height: 1.5em;
		margin: 1rem 0 0;
		color: #cbd5e1;
		text-align: center;
	}

	.results {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: start;
		gap: 1rem;
		margin-top: 2rem;
	}

	:global(.player-card) {
		min-width: 0;
		padding: 1.25rem;
		border: 1px solid #374151;
		border-radius: 0.75rem;
		background: #1f2937;
	}

	:global(.player-card h2) {
		margin: 0;
		overflow-wrap: anywhere;
		font-size: 1.25rem;
	}

	:global(.total) {
		margin: 0.5rem 0 0;
		color: #cbd5e1;
	}

	:global(.range) {
		color: #94a3b8;
		font-size: 0.85rem;
	}

	:global(.graph-wrap) {
		overflow-x: auto;
		padding: 0.75rem 0 0.25rem;
	}

	:global(.graph) {
		display: grid;
		grid-auto-columns: 0.62rem;
		grid-auto-flow: column;
		grid-template-rows: repeat(7, 0.62rem);
		gap: 0.2rem;
		width: max-content;
	}

	:global(.day) {
		width: 0.62rem;
		height: 0.62rem;
		border-radius: 2px;
		background-color: var(--day-color);
	}

	.results :global(.versus) {
		align-self: center;
		padding: 0.5rem 0;
	}

	@media (max-width: 640px) {
		.arena {
			padding: 2.5rem 0;
		}

		.players {
			grid-template-columns: 1fr;
		}

		.players .versus {
			justify-self: center;
			padding: 0;
		}

		.results {
			grid-template-columns: 1fr;
		}

		.results :global(.versus) {
			justify-self: center;
		}
	}
</style>

<script>
	interface ContributionDay {
		count: number;
		level: number;
		weekday: number;
	}

	interface ContributionWeek {
		first_day: string;
		contribution_days: ContributionDay[];
	}

	interface ContributionData {
		from: string;
		to: string;
		total_contributions: number;
		colors_full: string[];
		weeks: ContributionWeek[];
	}

	const form = document.querySelector<HTMLFormElement>('#battle-form');
	const playerOneInput = document.querySelector<HTMLInputElement>('#player-one');
	const playerTwoInput = document.querySelector<HTMLInputElement>('#player-two');
	const battleButton = document.querySelector<HTMLButtonElement>('#battle-button');
	const battleStatus = document.querySelector<HTMLParagraphElement>('#battle-status');
	const results = document.querySelector<HTMLElement>('#results');

	if (!form || !playerOneInput || !playerTwoInput || !battleButton || !battleStatus || !results) {
		throw new Error('Battle page is missing required form elements.');
	}

	function isContributionData(value: unknown): value is ContributionData {
		if (typeof value !== 'object' || value === null) return false;

		const data = value as Partial<ContributionData>;
		return typeof data.from === 'string'
			&& !Number.isNaN(Date.parse(`${data.from}T00:00:00Z`))
			&& typeof data.to === 'string'
			&& !Number.isNaN(Date.parse(`${data.to}T00:00:00Z`))
			&& typeof data.total_contributions === 'number'
			&& Number.isInteger(data.total_contributions)
			&& data.total_contributions >= 0
			&& Array.isArray(data.colors_full)
			&& data.colors_full.length > 0
			&& data.colors_full.every((color) => typeof color === 'string' && /^#[\da-f]{6}$/i.test(color))
			&& Array.isArray(data.weeks)
			&& data.weeks.every((week) => typeof week.first_day === 'string'
				&& !Number.isNaN(Date.parse(`${week.first_day}T00:00:00Z`))
				&& Array.isArray(week.contribution_days)
				&& week.contribution_days.every((day) => typeof day.count === 'number'
					&& Number.isInteger(day.count)
					&& day.count >= 0
					&& Number.isInteger(day.level)
					&& day.level >= 0
					&& day.level < data.colors_full.length
					&& Number.isInteger(day.weekday)
					&& day.weekday >= 0
					&& day.weekday <= 6));
	}

	function getApiErrorMessage(value: unknown): string | undefined {
		if (typeof value !== 'object' || value === null || !('error' in value)) return undefined;

		const apiError = (value as { error?: unknown }).error;
		if (typeof apiError !== 'object' || apiError === null || !('message' in apiError)) return undefined;

		const message = (apiError as { message?: unknown }).message;
		return typeof message === 'string' ? message : undefined;
	}

	async function fetchContributions(username: string): Promise<ContributionData> {
		const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
		const body: unknown = await response.json();

		if (!response.ok) {
			throw new Error(getApiErrorMessage(body) ?? `Could not load contributions for @${username}.`);
		}

		if (!isContributionData(body)) {
			throw new Error(`The contribution response for @${username} was not in the expected format.`);
		}

		return body;
	}

	function formatDate(date: string): string {
		return new Intl.DateTimeFormat(undefined, {
			month: 'short',
			day: 'numeric',
			year: 'numeric',
			timeZone: 'UTC',
		}).format(new Date(`${date}T00:00:00Z`));
	}

	function renderPlayer(username: string, data: ContributionData): HTMLElement {
		const card = document.createElement('article');
		card.className = 'player-card';

		const heading = document.createElement('h2');
		heading.textContent = `@${username}`;
		card.append(heading);

		const total = document.createElement('p');
		total.className = 'total';
		total.textContent = `${data.total_contributions.toLocaleString()} contributions`;
		card.append(total);

		const range = document.createElement('p');
		range.className = 'range';
		range.textContent = `${formatDate(data.from)} – ${formatDate(data.to)}`;
		card.append(range);

		const graphWrap = document.createElement('div');
		graphWrap.className = 'graph-wrap';
		const graph = document.createElement('div');
		graph.className = 'graph';
		graph.setAttribute('role', 'img');
		graph.setAttribute('aria-label', `Contribution activity for @${username}`);

		for (const week of data.weeks) {
			const firstDay = new Date(`${week.first_day}T00:00:00Z`);
			for (const day of week.contribution_days) {
				const date = new Date(firstDay);
				date.setUTCDate(date.getUTCDate() + day.weekday);

				const square = document.createElement('span');
				square.className = 'day';
				square.style.setProperty(
					'--day-color',
					data.colors_full[day.level] ?? data.colors_full[0] ?? '#ebedf0',
				);
				const dateLabel = date.toISOString().slice(0, 10);
				square.title = `${dateLabel}: ${day.count} contribution${day.count === 1 ? '' : 's'}`;
				graph.append(square);
			}
		}

		graphWrap.append(graph);
		card.append(graphWrap);
		return card;
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		const usernames = [playerOneInput.value.trim(), playerTwoInput.value.trim()];
		playerOneInput.removeAttribute('aria-invalid');
		playerTwoInput.removeAttribute('aria-invalid');
		results.replaceChildren();
		results.hidden = true;

		if (!usernames[0] || !usernames[1]) {
			if (!usernames[0]) playerOneInput.setAttribute('aria-invalid', 'true');
			if (!usernames[1]) playerTwoInput.setAttribute('aria-invalid', 'true');
			battleStatus.textContent = 'Enter a GitHub username for both players to start.';
			return;
		}

		battleButton.disabled = true;
		battleButton.textContent = 'Loading battle...';
		battleStatus.textContent = 'Fetching contribution data for both players...';

		try {
			const [playerOneData, playerTwoData] = await Promise.all([
				fetchContributions(usernames[0]),
				fetchContributions(usernames[1]),
			]);

			results.append(
				renderPlayer(usernames[0], playerOneData),
				Object.assign(document.createElement('span'), {
					className: 'versus',
					textContent: 'VS',
				}),
				renderPlayer(usernames[1], playerTwoData),
			);
			results.hidden = false;
			battleStatus.textContent = 'Battle results are ready. Compare the contribution totals and graphs below.';
		} catch (error) {
			battleStatus.textContent = error instanceof Error
				? error.message
				: 'Could not load contribution data. Please try again.';
		} finally {
			battleButton.disabled = false;
			battleButton.textContent = 'Start battle';
		}
	});
</script>
