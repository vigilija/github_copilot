---
const title = 'GitHub Contribution Battle Arena';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Compare GitHub contribution activity in a friendly head-to-head battle." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<title>{title} | Mona Mayhem</title>
	</head>
	<body>
		<main class="arena">
			<header class="intro">
				<p class="eyebrow">Mona Mayhem presents</p>
				<h1>{title}</h1>
				<p>Two developers enter. Compare a year of GitHub contributions.</p>
				<button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">
					Switch to blue + orange
				</button>
				<button id="sound-toggle" class="theme-toggle sound-toggle" type="button" aria-pressed="false">
					🔊 Sound On
				</button>
			</header>

			<form id="battle-form" novalidate>
				<div class="players">
					<div class="field">
						<label for="player-one">Player 1</label>
						<div class="username-input">
							<span aria-hidden="true">@</span>
							<input
								id="player-one"
								name="playerOne"
								type="text"
								autocomplete="username"
								placeholder="octocat"
								maxlength="39"
								aria-describedby="player-one-error"
								required
							/>
						</div>
						<p id="player-one-error" class="field-error" hidden></p>
					</div>

					<span class="versus" aria-hidden="true">VS</span>

					<div class="field">
						<label for="player-two">Player 2</label>
						<div class="username-input">
							<span aria-hidden="true">@</span>
							<input
								id="player-two"
								name="playerTwo"
								type="text"
								autocomplete="off"
								placeholder="torvalds"
								maxlength="39"
								aria-describedby="player-two-error"
								required
							/>
						</div>
						<p id="player-two-error" class="field-error" hidden></p>
					</div>
				</div>

				<button id="battle-button" type="submit">Battle!</button>
				<p id="battle-status" class="status" role="status" aria-live="polite"></p>
			</form>

			<div id="battle-countdown" class="countdown-overlay" role="status" aria-live="assertive" hidden>
				<p id="countdown-text" class="countdown-text"></p>
			</div>
			<section id="results" class="results" aria-label="Battle results" hidden></section>
			<section class="history" aria-labelledby="history-heading">
				<header class="history-header">
					<h2 id="history-heading">Recent Battles</h2>
					<button id="clear-history" class="clear-history" type="button" disabled>Clear History</button>
				</header>
				<ol id="history-list" class="history-list" aria-live="polite">
					<li class="history-empty">No battles yet. Start a battle to build your history.</li>
				</ol>
			</section>
			<div id="day-tooltip" class="day-tooltip" role="tooltip" hidden></div>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(:root) {
		--arcade-bg: #0a0a1a;
		--arcade-panel: #111126;
		--arcade-panel-raised: #17172f;
		--arcade-primary: #5fed83;
		--arcade-primary-rgb: 95 237 131;
		--arcade-secondary: #8a2be2;
		--arcade-secondary-rgb: 138 43 226;
		--arcade-button-start: #43117a;
		--arcade-button-end: #251047;
		--arcade-loading-end: #c49aff;
		--arcade-error: #ff3366;
		--arcade-text: #f3f4ff;
		--arcade-muted: #aaaac4;
		--arcade-font: "Press Start 2P", "Courier New", monospace;
	}

	:global(html[data-theme="blue-orange"]) {
		--arcade-primary: #00f5ff;
		--arcade-primary-rgb: 0 245 255;
		--arcade-secondary: #ff6b35;
		--arcade-secondary-rgb: 255 107 53;
		--arcade-button-start: #7a301a;
		--arcade-button-end: #471b10;
		--arcade-loading-end: #ff6b35;
	}

	:global(html) {
		min-height: 100%;
		background: var(--arcade-bg);
	}

	:global(body) {
		display: grid;
		min-height: 100vh;
		min-height: 100svh;
		place-items: center;
		isolation: isolate;
		margin: 0;
		min-width: 320px;
		background:
			radial-gradient(ellipse at 50% 0%, rgb(var(--arcade-secondary-rgb) / 15%), transparent 52%),
			var(--arcade-bg) fixed;
		color: var(--arcade-text);
		font-family: var(--arcade-font);
		font-size: 0.72rem;
		line-height: 1.9;
	}

	:global(body::before) {
		position: fixed;
		z-index: 0;
		inset: 0;
		background: repeating-linear-gradient(
			to bottom,
			transparent 0,
			transparent 2px,
			rgb(0 0 0 / 22%) 3px,
			rgb(0 0 0 / 22%) 4px
		);
		content: "";
		pointer-events: none;
	}

	.arena {
		position: relative;
		z-index: 1;
		width: min(calc(100% - 3rem), 1200px);
		margin: 0 auto;
		padding: 3rem 0;
	}

	.intro {
		margin-bottom: 2rem;
		text-align: center;
	}

	.eyebrow {
		color: var(--arcade-primary);
		font-size: 0.55rem;
		text-shadow: 0 0 10px rgb(var(--arcade-primary-rgb) / 65%);
	}

	h1 {
		margin: 1rem 0;
		color: var(--arcade-primary);
		font-size: clamp(1.25rem, 3vw, 2.1rem);
		line-height: 1.8;
		text-shadow: 0 0 5px var(--arcade-primary), 0 0 16px rgb(var(--arcade-primary-rgb) / 75%);
		animation: neon-pulse 2.4s ease-in-out infinite alternate;
	}

	.intro > p:last-child {
		color: var(--arcade-muted);
		font-size: 0.58rem;
	}

	form {
		padding: 1.5rem;
		border: 1px solid rgb(var(--arcade-secondary-rgb) / 70%);
		border-radius: 0.35rem;
		background: linear-gradient(145deg, rgb(23 23 47 / 96%), rgb(12 12 29 / 96%));
		box-shadow: 0 0 20px rgb(var(--arcade-secondary-rgb) / 16%), inset 0 0 18px rgb(var(--arcade-primary-rgb) / 4%);
	}

	.players {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: end;
		gap: 1.25rem;
	}

	.field label {
		display: block;
		margin-bottom: 0.5rem;
		color: var(--arcade-primary);
		font-size: 0.58rem;
	}

	.players > .field:first-child {
		animation: float-in 650ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
	}

	.players > .field:last-child {
		animation: float-in 650ms 160ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
	}

	.username-input {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0 0.75rem;
		border: 1px solid rgb(var(--arcade-secondary-rgb) / 70%);
		border-radius: 0.25rem;
		background: #080817;
		color: var(--arcade-secondary);
		transition: border-color 160ms ease, box-shadow 160ms ease;
	}

	input {
		width: 100%;
		min-width: 0;
		min-height: 44px;
		padding: 0.9rem 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--arcade-text);
		font: inherit;
		font-size: 0.55rem;
	}

	.username-input:focus-within {
		border-color: var(--arcade-primary);
		outline: 2px solid var(--arcade-primary);
		outline-offset: 2px;
		box-shadow: 0 0 12px rgb(var(--arcade-primary-rgb) / 28%);
	}

	.username-input.is-invalid {
		border-color: var(--arcade-error);
		box-shadow: 0 0 10px rgb(255 51 102 / 38%), inset 0 0 8px rgb(255 51 102 / 10%);
	}

	.username-input.is-invalid:focus-within {
		outline-color: var(--arcade-error);
		box-shadow: 0 0 14px rgb(255 51 102 / 48%), inset 0 0 8px rgb(255 51 102 / 10%);
	}

	.field-error {
		margin: 0.5rem 0 0;
		color: var(--arcade-error);
		font-size: 0.48rem;
		line-height: 1.8;
		text-shadow: 0 0 5px rgb(255 51 102 / 75%), 0 0 12px rgb(255 51 102 / 42%);
	}

	.field-error[hidden] {
		display: none;
	}

	input::placeholder {
		color: #777792;
	}

	.versus {
		padding-bottom: 0.65rem;
		background: linear-gradient(110deg, var(--arcade-primary), var(--arcade-secondary), var(--arcade-primary));
		background-size: 220% 100%;
		background-clip: text;
		color: transparent;
		font-size: 0.9rem;
		-webkit-text-fill-color: transparent;
		animation: versus-shift 2.6s linear infinite;
	}

	button {
		display: block;
		min-width: 12rem;
		min-height: 44px;
		margin: 1.5rem auto 0;
		padding: 1rem 1.25rem;
		border: 1px solid var(--arcade-secondary);
		border-radius: 0.25rem;
		background: linear-gradient(110deg, var(--arcade-button-start), var(--arcade-button-end));
		box-shadow: 0 0 12px rgb(var(--arcade-secondary-rgb) / 35%);
		color: var(--arcade-text);
		font: inherit;
		font-size: 0.55rem;
		cursor: pointer;
		transition: box-shadow 160ms ease, transform 160ms ease, border-color 160ms ease;
	}

	button:hover:not(:disabled) {
		transform: translateY(-2px);
		border-color: var(--arcade-primary);
		box-shadow: 0 0 18px rgb(var(--arcade-primary-rgb) / 38%);
	}

	button:focus-visible {
		outline: 2px solid var(--arcade-primary);
		outline-offset: 3px;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.7;
	}

	.theme-toggle {
		min-width: 0;
		min-height: 44px;
		margin: 1.25rem auto 0;
		padding: 0.65rem 0.8rem;
		border-color: var(--arcade-primary);
		background: var(--arcade-panel);
		box-shadow: 0 0 10px rgb(var(--arcade-primary-rgb) / 18%);
		font-size: 0.45rem;
	}

	.sound-toggle {
		margin-top: 0.65rem;
	}

	.status {
		min-height: 1.5em;
		margin: 1rem 0 0;
		color: var(--arcade-muted);
		font-size: 0.52rem;
		text-align: center;
	}

	.status.is-loading {
		animation: loading-colors 1.3s ease-in-out infinite alternate;
	}

	.status.is-error {
		color: var(--arcade-error);
		text-shadow: 0 0 5px rgb(255 51 102 / 78%), 0 0 14px rgb(255 51 102 / 48%);
	}

	.shake {
		animation: error-shake 420ms ease-in-out;
	}

	.results {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: start;
		gap: 1rem;
		margin-top: 2rem;
	}

	.results[hidden] {
		display: none;
	}

	:global(.countdown-overlay) {
		position: fixed;
		z-index: 20;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 1.5rem;
		background: rgb(5 5 18 / 88%);
		backdrop-filter: blur(5px);
	}

	:global(.countdown-overlay[hidden]) {
		display: none;
	}

	:global(.countdown-text) {
		margin: 0;
		color: var(--arcade-primary);
		font-size: clamp(2rem, 15vw, 7rem);
		line-height: 1.5;
		text-align: center;
		text-shadow: 0 0 12px var(--arcade-primary), 0 0 36px rgb(var(--arcade-primary-rgb) / 75%);
		animation: countdown-pop 900ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
	}

	.results.results-enter {
		animation: results-slide-in 650ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
	}

	.history {
		margin-top: 2rem;
		padding: 1.25rem;
		border: 1px solid rgb(var(--arcade-secondary-rgb) / 65%);
		border-radius: 0.35rem;
		background: linear-gradient(145deg, rgb(23 23 47 / 96%), rgb(12 12 29 / 96%));
		box-shadow: 0 0 16px rgb(var(--arcade-secondary-rgb) / 14%);
	}

	.history-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.history-header h2 {
		margin: 0;
		color: var(--arcade-primary);
		font-size: 0.75rem;
		line-height: 1.8;
		text-shadow: 0 0 8px rgb(var(--arcade-primary-rgb) / 48%);
	}

	.clear-history {
		min-width: 0;
		min-height: 44px;
		margin: 0;
		padding: 0.65rem 0.8rem;
		font-size: 0.45rem;
	}

	.history-list {
		display: grid;
		gap: 0.65rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.history-entry,
	.history-empty {
		padding: 0.85rem;
		border: 1px solid rgb(var(--arcade-primary-rgb) / 22%);
		border-radius: 0.25rem;
		background: rgb(8 8 23 / 70%);
		color: var(--arcade-muted);
		font-size: 0.48rem;
		line-height: 1.9;
	}

	.history-players {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.25rem;
		color: var(--arcade-text);
		overflow-wrap: anywhere;
	}

	.history-result {
		margin: 0.3rem 0 0;
		color: var(--arcade-primary);
	}

	.history-date {
		display: block;
		margin-top: 0.2rem;
		color: var(--arcade-muted);
	}

	:global(.champion-banner) {
		position: relative;
		grid-column: 1 / -1;
		margin: 0 0 0.5rem;
		padding: 1.25rem 1rem;
		overflow: hidden;
		border: 2px solid var(--arcade-primary);
		border-radius: 0.35rem;
		background: linear-gradient(110deg, rgb(var(--arcade-primary-rgb) / 18%), rgb(var(--arcade-secondary-rgb) / 24%));
		box-shadow: 0 0 18px rgb(var(--arcade-primary-rgb) / 30%), inset 0 0 18px rgb(var(--arcade-secondary-rgb) / 15%);
		color: var(--arcade-primary);
		font-size: clamp(0.65rem, 2.2vw, 1rem);
		line-height: 1.8;
		text-align: center;
		text-shadow: 0 0 8px rgb(var(--arcade-primary-rgb) / 85%), 0 0 20px rgb(var(--arcade-secondary-rgb) / 60%);
		overflow-wrap: anywhere;
		animation: champion-enter 700ms cubic-bezier(0.2, 0.75, 0.25, 1) both, champion-glow 1.8s 700ms ease-in-out infinite alternate;
	}

	:global(.champion-banner::after) {
		position: absolute;
		inset: 0;
		background: linear-gradient(110deg, transparent 25%, rgb(255 255 255 / 18%) 50%, transparent 75%);
		content: "";
		pointer-events: none;
		transform: translateX(-120%);
		animation: champion-shine 1.2s 250ms ease-out both;
	}

	:global(.player-card) {
		position: relative;
		isolation: isolate;
		min-width: 0;
		padding: 1.25rem;
		overflow: hidden;
		border: 1px solid rgb(var(--arcade-primary-rgb) / 52%);
		border-radius: 0.3rem;
		background: linear-gradient(145deg, var(--arcade-panel-raised), var(--arcade-panel));
		box-shadow: 0 0 14px rgb(var(--arcade-primary-rgb) / 10%);
		animation: card-enter 500ms ease-out both;
	}

	:global(.player-card::after) {
		position: absolute;
		z-index: 0;
		inset: -80% -50%;
		background: linear-gradient(
			115deg,
			transparent 42%,
			rgb(var(--arcade-primary-rgb) / 13%) 48%,
			rgb(var(--arcade-secondary-rgb) / 18%) 50%,
			transparent 57%
		);
		content: "";
		pointer-events: none;
		transform: translateX(-65%);
		animation: card-shimmer 1.4s 180ms ease-out both;
	}

	:global(.player-card h2) {
		position: relative;
		z-index: 1;
		margin: 0;
		overflow-wrap: anywhere;
		color: var(--arcade-primary);
		font-size: 0.72rem;
		line-height: 1.8;
	}

	:global(.total) {
		position: relative;
		z-index: 1;
		margin: 0.5rem 0 0;
		color: var(--arcade-text);
		font-size: 0.55rem;
	}

	:global(.range) {
		position: relative;
		z-index: 1;
		color: var(--arcade-muted);
		font-size: 0.48rem;
	}

	:global(.streak) {
		position: relative;
		z-index: 1;
		margin: 0.75rem 0 0;
		color: var(--arcade-primary);
		font-size: 0.52rem;
		text-shadow: 0 0 8px rgb(var(--arcade-primary-rgb) / 48%);
	}

	:global(.graph-wrap) {
		position: relative;
		z-index: 1;
		overflow-x: auto;
		padding: 0.75rem 0 0.25rem;
	}

	:global(.graph) {
		display: grid;
		grid-auto-columns: 0.62rem;
		grid-auto-flow: column;
		grid-template-rows: repeat(7, 0.62rem);
		gap: 0.2rem;
		width: max-content;
	}

	:global(.day) {
		position: relative;
		width: 0.62rem;
		height: 0.62rem;
		border: 1px solid rgb(255 255 255 / 8%);
		border-radius: 1px;
		background-color: var(--day-color);
		transition: transform 130ms ease, box-shadow 130ms ease, z-index 130ms ease;
	}

	:global(.day:hover) {
		z-index: 2;
		transform: scale(1.55);
		box-shadow: 0 0 6px var(--day-color), 0 0 13px var(--arcade-primary);
	}

	:global(.day-tooltip) {
		position: fixed;
		z-index: 10;
		max-width: calc(100vw - 1rem);
		padding: 0.4rem 0.6rem;
		border: 1px solid var(--arcade-secondary);
		border-radius: 0.2rem;
		background: #080817;
		box-shadow: 0 0 12px rgb(var(--arcade-secondary-rgb) / 35%);
		color: var(--arcade-text);
		font-family: system-ui, sans-serif;
		font-size: 0.75rem;
		line-height: 1.3;
		white-space: nowrap;
		pointer-events: none;
	}

	:global(.day-tooltip[hidden]) {
		display: none;
	}

	.results :global(.versus) {
		align-self: center;
		padding: 0.5rem 0;
		background: linear-gradient(110deg, var(--arcade-primary), var(--arcade-secondary), var(--arcade-primary));
		background-size: 220% 100%;
		background-clip: text;
		color: transparent;
		font-size: 0.75rem;
		-webkit-text-fill-color: transparent;
		animation: versus-shift 2.6s linear infinite;
	}

	@keyframes neon-pulse {
		from {
			text-shadow: 0 0 4px var(--arcade-primary), 0 0 10px rgb(var(--arcade-primary-rgb) / 52%);
		}

		to {
			text-shadow: 0 0 8px var(--arcade-primary), 0 0 24px rgb(var(--arcade-primary-rgb) / 92%);
		}
	}

	@keyframes versus-shift {
		to {
			background-position: 220% 0;
		}
	}

	@keyframes float-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes loading-colors {
		from {
			color: var(--arcade-primary);
			text-shadow: 0 0 7px rgb(var(--arcade-primary-rgb) / 55%);
		}

		@keyframes error-shake {
			0%, 100% {
				transform: translateX(0);
			}

			20%, 60% {
				transform: translateX(-5px);
			}

			40%, 80% {
				transform: translateX(5px);
			}
		}

		to {
			color: var(--arcade-loading-end);
			text-shadow: 0 0 9px rgb(var(--arcade-secondary-rgb) / 75%);
		}
	}

	@keyframes card-enter {
		from {
			opacity: 0;
			transform: translateY(10px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes countdown-pop {
		from {
			opacity: 0;
			transform: scale(0.55);
		}

		35% {
			opacity: 1;
			transform: scale(1.12);
		}

		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes results-slide-in {
		from {
			opacity: 0;
			transform: translateY(36px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes champion-enter {
		from {
			opacity: 0;
			transform: scale(0.85) translateY(12px);
		}

		70% {
			transform: scale(1.04);
		}

		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes champion-glow {
		from {
			box-shadow: 0 0 14px rgb(var(--arcade-primary-rgb) / 24%), inset 0 0 14px rgb(var(--arcade-secondary-rgb) / 12%);
		}

		to {
			box-shadow: 0 0 28px rgb(var(--arcade-primary-rgb) / 48%), inset 0 0 22px rgb(var(--arcade-secondary-rgb) / 24%);
		}
	}

	@keyframes champion-shine {
		to {
			transform: translateX(120%);
		}
	}

	@keyframes card-shimmer {
		to {
			transform: translateX(65%);
		}
	}

	@media (max-width: 1024px) {
		.results {
			grid-template-columns: minmax(0, 1fr);
		}

		.results :global(.versus) {
			justify-self: center;
		}
	}

	@media (max-width: 768px) {
		:global(body) {
			font-size: 0.65rem;
		}

		.arena {
			width: min(calc(100% - 2rem), 1200px);
			padding: 2rem 0;
		}

		h1 {
			font-size: clamp(1rem, 5vw, 1.6rem);
		}

		.intro > p:last-child {
			font-size: 0.52rem;
		}

		form {
			padding: 1rem;
		}

		.players {
			grid-template-columns: minmax(0, 1fr);
		}

		.history {
			padding: 1rem;
		}

		.history-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.players .versus {
			justify-self: center;
			padding: 0;
		}

		input {
			font-size: 0.65rem;
		}

		:global(.player-card) {
			padding: 1rem;
		}

		.results :global(.versus) {
			justify-self: center;
		}
	}

	@media (max-width: 480px) {
		.arena {
			padding: 1.5rem 0;
		}

		form {
			padding: 0.75rem;
		}

		button {
			width: 100%;
			min-width: 0;
		}

		.clear-history {
			width: auto;
			align-self: stretch;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(*),
		:global(*::before),
		:global(*::after) {
			scroll-behavior: auto !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>

<script>
	interface ContributionDay {
		count: number;
		level: number;
		weekday: number;
	}

	interface ContributionWeek {
		first_day: string;
		contribution_days: ContributionDay[];
	}

	interface ContributionData {
		from: string;
		to: string;
		total_contributions: number;
		colors_full: string[];
		weeks: ContributionWeek[];
	}

	interface BattleHistoryEntry {
		playerOne: { username: string; totalContributions: number };
		playerTwo: { username: string; totalContributions: number };
		winner: string | null;
		happenedAt: string;
	}

	const form = document.querySelector<HTMLFormElement>('#battle-form');
	const playerOneInput = document.querySelector<HTMLInputElement>('#player-one');
	const playerTwoInput = document.querySelector<HTMLInputElement>('#player-two');
	const battleButton = document.querySelector<HTMLButtonElement>('#battle-button');
	const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
	const soundToggle = document.querySelector<HTMLButtonElement>('#sound-toggle');
	const battleCountdown = document.querySelector<HTMLDivElement>('#battle-countdown');
	const countdownText = document.querySelector<HTMLParagraphElement>('#countdown-text');
	const battleStatus = document.querySelector<HTMLParagraphElement>('#battle-status');
	const playerOneError = document.querySelector<HTMLParagraphElement>('#player-one-error');
	const playerTwoError = document.querySelector<HTMLParagraphElement>('#player-two-error');
	const results = document.querySelector<HTMLElement>('#results');
	const historyList = document.querySelector<HTMLOListElement>('#history-list');
	const clearHistoryButton = document.querySelector<HTMLButtonElement>('#clear-history');
	const dayTooltip = document.querySelector<HTMLDivElement>('#day-tooltip');

	if (!form || !playerOneInput || !playerTwoInput || !battleButton || !themeToggle || !soundToggle
		|| !battleCountdown || !countdownText || !battleStatus
		|| !playerOneError || !playerTwoError || !results || !historyList || !clearHistoryButton || !dayTooltip) {
		throw new Error('Battle page is missing required form elements.');
	}

	const historyStorageKey = 'mona-mayhem:recent-battles';
	const maxHistoryEntries = 10;
	let validationActive = false;
	let battleHistory: BattleHistoryEntry[] = [];
	let audioContext: AudioContext | undefined;
	let soundMuted = false;
	let audioWarningShown = false;

	type SoundEffect = 'coin' | 'power-up' | 'explosion';

	function reportAudioError(error: unknown): void {
		if (audioWarningShown) return;
		audioWarningShown = true;
		console.warn('Arcade sound effects are unavailable', error);
	}

	function playTone(
		context: AudioContext,
		startTime: number,
		startFrequency: number,
		endFrequency: number,
		duration: number,
		waveform: OscillatorType,
		volume: number,
	): void {
		const oscillator = context.createOscillator();
		const gain = context.createGain();
		oscillator.type = waveform;
		oscillator.frequency.setValueAtTime(startFrequency, startTime);
		oscillator.frequency.exponentialRampToValueAtTime(endFrequency, startTime + duration);
		gain.gain.setValueAtTime(0.0001, startTime);
		gain.gain.linearRampToValueAtTime(volume, startTime + 0.01);
		gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);
		oscillator.connect(gain);
		gain.connect(context.destination);
		oscillator.start(startTime);
		oscillator.stop(startTime + duration);
	}

	function scheduleSound(context: AudioContext, effect: SoundEffect): void {
		const start = context.currentTime + 0.02;
		if (effect === 'coin') {
			playTone(context, start, 880, 880, 0.07, 'square', 0.09);
			playTone(context, start + 0.075, 1320, 1320, 0.12, 'square', 0.08);
		} else if (effect === 'power-up') {
			playTone(context, start, 440, 660, 0.15, 'sine', 0.1);
			playTone(context, start + 0.11, 660, 990, 0.17, 'triangle', 0.1);
			playTone(context, start + 0.23, 880, 1760, 0.24, 'square', 0.07);
		} else {
			playTone(context, start, 110, 32, 0.42, 'sawtooth', 0.18);
			playTone(context, start, 72, 28, 0.38, 'triangle', 0.14);
			playTone(context, start + 0.015, 48, 36, 0.3, 'square', 0.08);
		}
	}

	function playSound(effect: SoundEffect): void {
		if (soundMuted) return;

		try {
			audioContext ??= new window.AudioContext();
			const context = audioContext;
			const play = () => scheduleSound(context, effect);
			if (context.state === 'suspended') {
				void context.resume().then(play).catch(reportAudioError);
			} else {
				play();
			}
		} catch (error) {
			reportAudioError(error);
		}
	}

	function waitForCountdownStep(signal: AbortSignal): Promise<void> {
		return new Promise((resolve) => {
			const finish = () => {
				window.clearTimeout(timeout);
				signal.removeEventListener('abort', finish);
				resolve();
			};
			const timeout = window.setTimeout(finish, 1_000);
			signal.addEventListener('abort', finish, { once: true });
			if (signal.aborted) finish();
		});
	}

	async function runBattleCountdown(signal: AbortSignal): Promise<void> {
		const steps = ['3...', '2...', '1...', '⚡ FIGHT! ⚡'];
		battleCountdown.hidden = false;

		for (const step of steps) {
			if (signal.aborted) break;
			countdownText.textContent = step;
			countdownText.style.animation = 'none';
			void countdownText.offsetWidth;
			countdownText.style.animation = '';
			await waitForCountdownStep(signal);
		}

		battleCountdown.hidden = true;
	}

	themeToggle.addEventListener('click', () => {
		const useBlueOrange = document.documentElement.dataset.theme !== 'blue-orange';
		if (useBlueOrange) {
			document.documentElement.dataset.theme = 'blue-orange';
		} else {
			delete document.documentElement.dataset.theme;
		}

		themeToggle.setAttribute('aria-pressed', String(useBlueOrange));
		themeToggle.textContent = useBlueOrange
			? 'Switch to green + purple'
			: 'Switch to blue + orange';
	});

	soundToggle.addEventListener('click', () => {
		soundMuted = !soundMuted;
		soundToggle.setAttribute('aria-pressed', String(soundMuted));
		soundToggle.textContent = soundMuted ? '🔇 Sound Off' : '🔊 Sound On';
	});

	function validateUsername(username: string): string | undefined {
		if (!username) return 'Enter a GitHub username.';
		if (username.length > 39 || !/^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$/.test(username)) {
			return 'Use 1-39 letters or numbers, with single hyphens only between characters.';
		}
		return undefined;
	}

	function isBattleHistoryEntry(value: unknown): value is BattleHistoryEntry {
		if (typeof value !== 'object' || value === null) return false;
		const entry = value as Partial<BattleHistoryEntry>;
		const isPlayer = (player: unknown): player is BattleHistoryEntry['playerOne'] => {
			if (typeof player !== 'object' || player === null) return false;
			const candidate = player as Partial<BattleHistoryEntry['playerOne']>;
			return typeof candidate.username === 'string'
				&& validateUsername(candidate.username) === undefined
				&& typeof candidate.totalContributions === 'number'
				&& Number.isInteger(candidate.totalContributions)
				&& candidate.totalContributions >= 0;
		};

		return isPlayer(entry.playerOne)
			&& isPlayer(entry.playerTwo)
			&& (entry.winner === null
				|| (typeof entry.winner === 'string'
					&& (entry.winner === entry.playerOne.username || entry.winner === entry.playerTwo.username)))
			&& typeof entry.happenedAt === 'string'
			&& !Number.isNaN(Date.parse(entry.happenedAt))
			&& (entry.playerOne.totalContributions === entry.playerTwo.totalContributions
				? entry.winner === null
				: entry.winner === (entry.playerOne.totalContributions > entry.playerTwo.totalContributions
					? entry.playerOne.username
					: entry.playerTwo.username));
	}

	function readBattleHistory(): BattleHistoryEntry[] {
		const storedHistory = localStorage.getItem(historyStorageKey);
		if (storedHistory === null) return [];

		const parsed: unknown = JSON.parse(storedHistory);
		if (!Array.isArray(parsed) || !parsed.every(isBattleHistoryEntry)) {
			throw new Error('Saved battle history is invalid. Clear history to start fresh.');
		}
		return parsed.slice(0, maxHistoryEntries);
	}

	function renderBattleHistory(): void {
		historyList.replaceChildren();
		clearHistoryButton.disabled = battleHistory.length === 0;
		if (battleHistory.length === 0) {
			const empty = document.createElement('li');
			empty.className = 'history-empty';
			empty.textContent = 'No battles yet. Start a battle to build your history.';
			historyList.append(empty);
			return;
		}

		for (const entry of battleHistory) {
			const item = document.createElement('li');
			item.className = 'history-entry';

			const players = document.createElement('div');
			players.className = 'history-players';
			for (const player of [entry.playerOne, entry.playerTwo]) {
				const playerTotal = document.createElement('span');
				playerTotal.textContent = `@${player.username}: ${player.totalContributions.toLocaleString()}`;
				players.append(playerTotal);
			}

			const result = document.createElement('p');
			result.className = 'history-result';
			result.textContent = entry.winner === null ? "Result: It's a tie" : `Winner: @${entry.winner}`;

			const date = document.createElement('time');
			date.className = 'history-date';
			date.dateTime = entry.happenedAt;
			date.textContent = new Intl.DateTimeFormat(undefined, {
				dateStyle: 'medium',
				timeStyle: 'short',
			}).format(new Date(entry.happenedAt));

			item.append(players, result, date);
			historyList.append(item);
		}
	}

	function setFieldError(
		input: HTMLInputElement,
		errorElement: HTMLParagraphElement,
		message: string | undefined,
		animate = false,
	): void {
		const wrapper = input.closest<HTMLElement>('.username-input');
		if (!wrapper) throw new Error(`Username field ${input.id} is missing its input wrapper.`);

		wrapper.classList.toggle('is-invalid', Boolean(message));
		errorElement.textContent = message ?? '';
		errorElement.hidden = !message;

		if (message) {
			input.setAttribute('aria-invalid', 'true');
			if (animate) triggerShake(wrapper);
		} else {
			input.removeAttribute('aria-invalid');
			wrapper.classList.remove('shake');
		}
	}

	function triggerShake(element: HTMLElement): void {
		element.classList.remove('shake');
		void element.offsetWidth;
		element.classList.add('shake');
	}

	function updateValidationSummary(): void {
		const errors = [
			{ player: 'Player 1', message: validateUsername(playerOneInput.value.trim()) },
			{ player: 'Player 2', message: validateUsername(playerTwoInput.value.trim()) },
		];
		setFieldError(playerOneInput, playerOneError, errors[0].message);
		setFieldError(playerTwoInput, playerTwoError, errors[1].message);

		const remainingErrors = errors
			.filter((error): error is { player: string; message: string } => Boolean(error.message))
			.map((error) => `${error.player}: ${error.message}`);

		if (remainingErrors.length) {
			battleStatus.textContent = remainingErrors.join(' ');
			battleStatus.classList.add('is-error');
		} else {
			battleStatus.textContent = '';
			battleStatus.classList.remove('is-error', 'shake');
			validationActive = false;
		}
	}

	playerOneInput.addEventListener('input', () => {
		if (validationActive) updateValidationSummary();
	});
	playerTwoInput.addEventListener('input', () => {
		if (validationActive) updateValidationSummary();
	});

	function isContributionData(value: unknown): value is ContributionData {
		if (typeof value !== 'object' || value === null) return false;

		const data = value as Partial<ContributionData>;
		return typeof data.from === 'string'
			&& !Number.isNaN(Date.parse(`${data.from}T00:00:00Z`))
			&& typeof data.to === 'string'
			&& !Number.isNaN(Date.parse(`${data.to}T00:00:00Z`))
			&& typeof data.total_contributions === 'number'
			&& Number.isInteger(data.total_contributions)
			&& data.total_contributions >= 0
			&& Array.isArray(data.colors_full)
			&& data.colors_full.length > 0
			&& data.colors_full.every((color) => typeof color === 'string' && /^#[\da-f]{6}$/i.test(color))
			&& Array.isArray(data.weeks)
			&& data.weeks.every((week) => typeof week.first_day === 'string'
				&& !Number.isNaN(Date.parse(`${week.first_day}T00:00:00Z`))
				&& Array.isArray(week.contribution_days)
				&& week.contribution_days.every((day) => typeof day.count === 'number'
					&& Number.isInteger(day.count)
					&& day.count >= 0
					&& Number.isInteger(day.level)
					&& day.level >= 0
					&& day.level < data.colors_full.length
					&& Number.isInteger(day.weekday)
					&& day.weekday >= 0
					&& day.weekday <= 6));
	}

	function getApiErrorMessage(value: unknown): string | undefined {
		if (typeof value !== 'object' || value === null || !('error' in value)) return undefined;

		const apiError = (value as { error?: unknown }).error;
		if (typeof apiError !== 'object' || apiError === null || !('message' in apiError)) return undefined;

		const message = (apiError as { message?: unknown }).message;
		return typeof message === 'string' ? message : undefined;
	}

	async function fetchContributions(username: string): Promise<ContributionData> {
		const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
		const body: unknown = await response.json();

		if (!response.ok) {
			throw new Error(getApiErrorMessage(body) ?? `Could not load contributions for @${username}.`);
		}

		if (!isContributionData(body)) {
			throw new Error(`The contribution response for @${username} was not in the expected format.`);
		}

		return body;
	}

	function formatDate(date: string): string {
		return new Intl.DateTimeFormat(undefined, {
			month: 'short',
			day: 'numeric',
			year: 'numeric',
			timeZone: 'UTC',
		}).format(new Date(`${date}T00:00:00Z`));
	}

	function getLongestContributionStreak(data: ContributionData): number {
		const contributionDates = new Set<number>();
		for (const week of data.weeks) {
			const firstDay = new Date(`${week.first_day}T00:00:00Z`);
			for (const day of week.contribution_days) {
				if (day.count === 0) continue;

				const date = new Date(firstDay);
				date.setUTCDate(date.getUTCDate() + day.weekday);
				contributionDates.add(date.getTime());
			}
		}

		const sortedDates = [...contributionDates].sort((a, b) => a - b);
		let longestStreak = 0;
		let currentStreak = 0;
		let previousDate: number | undefined;
		const oneDay = 24 * 60 * 60 * 1000;

		for (const date of sortedDates) {
			currentStreak = previousDate !== undefined && date - previousDate === oneDay
				? currentStreak + 1
				: 1;
			longestStreak = Math.max(longestStreak, currentStreak);
			previousDate = date;
		}

		return longestStreak;
	}

	function renderPlayer(username: string, data: ContributionData): HTMLElement {
		const card = document.createElement('article');
		card.className = 'player-card';

		const heading = document.createElement('h2');
		heading.textContent = `@${username}`;
		card.append(heading);

		const total = document.createElement('p');
		total.className = 'total';
		total.textContent = `${data.total_contributions.toLocaleString()} contributions`;
		card.append(total);

		const range = document.createElement('p');
		range.className = 'range';
		range.textContent = `${formatDate(data.from)} – ${formatDate(data.to)}`;
		card.append(range);

		const graphWrap = document.createElement('div');
		graphWrap.className = 'graph-wrap';
		const graph = document.createElement('div');
		graph.className = 'graph';
		graph.setAttribute('role', 'img');
		graph.setAttribute('aria-label', `Contribution activity for @${username}`);

		for (const week of data.weeks) {
			const firstDay = new Date(`${week.first_day}T00:00:00Z`);
			for (const day of week.contribution_days) {
				const date = new Date(firstDay);
				date.setUTCDate(date.getUTCDate() + day.weekday);

				const square = document.createElement('span');
				square.className = 'day';
				square.style.setProperty(
					'--day-color',
					data.colors_full[day.level] ?? data.colors_full[0] ?? '#ebedf0',
				);
				const dateLabel = date.toISOString().slice(0, 10);
				square.dataset.tooltip = `${formatDate(dateLabel)} · ${day.count} contribution${day.count === 1 ? '' : 's'}`;
				graph.append(square);
			}
		}

		graphWrap.append(graph);
		card.append(graphWrap);

		const streak = document.createElement('p');
		streak.className = 'streak';
		streak.textContent = `🔥 Longest Streak: ${getLongestContributionStreak(data)} days`;
		card.append(streak);
		return card;
	}

	function showDayTooltip(square: HTMLElement): void {
		const tooltipText = square.dataset.tooltip;
		if (!tooltipText) return;

		dayTooltip.textContent = tooltipText;
		dayTooltip.hidden = false;
		square.setAttribute('aria-describedby', 'day-tooltip');

		const squareRect = square.getBoundingClientRect();
		const tooltipRect = dayTooltip.getBoundingClientRect();
		const left = Math.min(
			Math.max(squareRect.left + squareRect.width / 2 - tooltipRect.width / 2, 8),
			window.innerWidth - tooltipRect.width - 8,
		);
		const top = squareRect.top - tooltipRect.height - 8 >= 8
			? squareRect.top - tooltipRect.height - 8
			: squareRect.bottom + 8;

		dayTooltip.style.left = `${left}px`;
		dayTooltip.style.top = `${top}px`;
	}

	function hideDayTooltip(): void {
		dayTooltip.hidden = true;
		results.querySelector('[aria-describedby="day-tooltip"]')?.removeAttribute('aria-describedby');
	}

	try {
		battleHistory = readBattleHistory();
		renderBattleHistory();
	} catch (error) {
		battleStatus.textContent = error instanceof Error
			? `Could not load recent battles: ${error.message}`
			: 'Could not load recent battles from local storage.';
		battleStatus.classList.add('is-error');
		clearHistoryButton.disabled = false;
	}

	clearHistoryButton.addEventListener('click', () => {
		try {
			localStorage.removeItem(historyStorageKey);
			battleHistory = [];
			renderBattleHistory();
			battleStatus.textContent = 'Battle history cleared.';
			battleStatus.classList.remove('is-error');
		} catch (error) {
			playSound('explosion');
			battleStatus.textContent = error instanceof Error
				? `Could not clear battle history: ${error.message}`
				: 'Could not clear battle history from local storage.';
			battleStatus.classList.add('is-error');
		}
	});

	results.addEventListener('pointerover', (event) => {
		const target = event.target;
		if (target instanceof Element) {
			const square = target.closest<HTMLElement>('.day');
			if (square && results.contains(square)) showDayTooltip(square);
		}
	});

	results.addEventListener('pointerout', (event) => {
		const nextTarget = event.relatedTarget;
		if (nextTarget instanceof Element && nextTarget.closest('.day') && results.contains(nextTarget)) {
			return;
		}
		hideDayTooltip();
	});

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		const usernames = [playerOneInput.value.trim(), playerTwoInput.value.trim()];
		const playerOneMessage = validateUsername(usernames[0]);
		const playerTwoMessage = validateUsername(usernames[1]);
		setFieldError(playerOneInput, playerOneError, playerOneMessage, Boolean(playerOneMessage));
		setFieldError(playerTwoInput, playerTwoError, playerTwoMessage, Boolean(playerTwoMessage));
		results.replaceChildren();
		results.hidden = true;
		results.classList.remove('results-enter');
		battleCountdown.hidden = true;

		if (playerOneMessage || playerTwoMessage) {
			playSound('explosion');
			validationActive = true;
			const errors = [
				playerOneMessage ? `Player 1: ${playerOneMessage}` : '',
				playerTwoMessage ? `Player 2: ${playerTwoMessage}` : '',
			].filter(Boolean);
			battleStatus.textContent = errors.join(' ');
			battleStatus.classList.remove('is-loading');
			battleStatus.classList.add('is-error');
			triggerShake(battleStatus);
			return;
		}

		validationActive = false;
		battleStatus.classList.remove('is-error', 'shake');
		playSound('coin');
		battleButton.disabled = true;
		battleButton.textContent = 'Fighting...';
		battleStatus.classList.add('is-loading');
		battleStatus.textContent = 'Fetching contribution data for both players...';
		const countdownController = new AbortController();

		try {
			const contributionsPromise = Promise.all([
				fetchContributions(usernames[0]),
				fetchContributions(usernames[1]),
			]);
			const [[playerOneData, playerTwoData]] = await Promise.all([
				contributionsPromise,
				runBattleCountdown(countdownController.signal),
			]);

			const winner = playerOneData.total_contributions === playerTwoData.total_contributions
				? null
				: playerOneData.total_contributions > playerTwoData.total_contributions
					? usernames[0]
					: usernames[1];
			const historyEntry: BattleHistoryEntry = {
				playerOne: { username: usernames[0], totalContributions: playerOneData.total_contributions },
				playerTwo: { username: usernames[1], totalContributions: playerTwoData.total_contributions },
				winner,
				happenedAt: new Date().toISOString(),
			};

			const champion = document.createElement('p');
			champion.className = 'champion-banner';
			champion.setAttribute('role', 'status');
			champion.setAttribute('aria-live', 'polite');
			if (winner === null) {
				champion.textContent = `🤝 ${usernames[0]} & ${usernames[1]} IT'S A TIE! 🤝`;
			} else {
				champion.textContent = `🏆 ${winner} WINS! 🏆`;
			}

			results.append(
				champion,
				renderPlayer(usernames[0], playerOneData),
				Object.assign(document.createElement('span'), {
					className: 'versus',
					textContent: 'VS',
				}),
				renderPlayer(usernames[1], playerTwoData),
			);
			results.hidden = false;
			void results.offsetWidth;
			results.classList.add('results-enter');
			playSound('power-up');
			const updatedHistory = [historyEntry, ...battleHistory].slice(0, maxHistoryEntries);
			try {
				localStorage.setItem(historyStorageKey, JSON.stringify(updatedHistory));
			} catch (error) {
				playSound('explosion');
				battleStatus.textContent = error instanceof Error
					? `Battle results are ready, but could not save history: ${error.message}`
					: 'Battle results are ready, but could not save history to local storage.';
				battleStatus.classList.add('is-error');
				return;
			}
			battleHistory = updatedHistory;
			renderBattleHistory();
			battleStatus.textContent = 'Battle results are ready. Compare the contribution totals and graphs below.';
			battleStatus.classList.remove('is-error');
		} catch (error) {
			playSound('explosion');
			battleStatus.textContent = error instanceof Error
				? error.message
				: 'Could not load contribution data. Please try again.';
			battleStatus.classList.add('is-error');
			triggerShake(battleStatus);
		} finally {
			countdownController.abort();
			battleCountdown.hidden = true;
			battleStatus.classList.remove('is-loading');
			battleButton.disabled = false;
			battleButton.textContent = 'Battle!';
		}
	});
</script>
